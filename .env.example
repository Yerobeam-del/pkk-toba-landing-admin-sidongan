APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# JANGAN true di production — debug page membocorkan source, env, dan stack trace.
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pkk_toba
DB_USERNAME=root
DB_PASSWORD=

# ============================================
# KONEKSI DATABASE SIEDA (untuk Manajemen Data SIEDA)
# ============================================
# Koneksi kedua ini dipakai oleh modul admin untuk membaca/menghapus
# data dari aplikasi SIEDA secara langsung (bukan via API).
# Jika diisi kosong, default-nya akan fallback ke DB_* utama di atas.
DB_SIEDA_HOST=127.0.0.1
DB_SIEDA_PORT=3306
DB_SIEDA_DATABASE=db_sieda_app
DB_SIEDA_USERNAME=root
DB_SIEDA_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ============================================
# KEAMANAN SESSION COOKIE
# ============================================
# secure=true  → cookie hanya dikirim lewat HTTPS (WAJIB di production).
# http_only=true → cookie tidak bisa dibaca JavaScript (mitigasi XSS).
# same_site=lax → mitigasi CSRF lintas situs.
# ============================================
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================
# KONFIGURASI MAIL (UNTUK FITUR LUPA PASSWORD)
# ============================================
# PENTING: Fitur Lupa Password membutuhkan mail server yang berfungsi.
# Isi variabel di bawah dengan kredensial SMTP yang valid.
# 
# Untuk DEVELOPMENT (testing tanpa email sungguhan):
#   MAIL_MAILER=log
#   (Email akan ditulis ke storage/logs/laravel.log, bukan dikirim)
#
# Untuk PRODUCTION (contoh dengan Gmail):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=admin@tp-pkk.tobakab.go.id
#   MAIL_PASSWORD=your-gmail-app-password
#   MAIL_ENCRYPTION=tls
#
# Catatan Gmail: harus aktifkan 2FA dan buat App Password khusus.
# Catatan domain: pastikan MAIL_FROM_ADDRESS menggunakan domain resmi.
# ============================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Domain untuk multi-domain routing
LANDING_DOMAIN=tp-pkk.tobakab.go.id
SIDONGAN_DOMAIN=sidongan.tobakab.go.id

# ============================================
# KONFIGURASI SIEDA BACKEND SYNC
# ============================================
# URL base backend SIEDA (tanpa trailing slash)
SIEDA_API_URL=http://127.0.0.1:8004
# Shared secret — HARUS SAMA dengan SIEDA_SYNC_SECRET di .env aplikasi SIEDA
# Generate dengan: php artisan tinker --execute="echo Str::random(64);"
SIEDA_SYNC_SECRET=
